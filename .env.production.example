# Copy this file to .env.production on the VPS and replace every placeholder.
# Keep this file private and never commit .env.production.
MONGO_ROOT_USERNAME=freshcart_admin
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password

PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.example
JWT_SECRET=replace_with_a_random_secret_at_least_48_characters_long
MONGO_URI=replace_by_docker_compose
ALLOW_EPHEMERAL_DB=false
SEED_DEMO_DATA=false
COMMISSION_PERCENT=5
MAX_DISTANCE_METERS=20000

# Leave empty until Razorpay is configured. Use test credentials first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
